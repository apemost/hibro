{
  "name": "hibro",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "release": "release-it",
    "dev": "vite",
    "build": "vite build",
    "package": "node scripts/package-extension.mjs",
    "docs:dev": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build",
    "docs:preview": "pnpm --dir docs preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test:package": "node --test test/package-extension.test.mjs",
    "test:e2e": "pnpm build && playwright test",
    "test:docs": "node --test test/docs-build.test.mjs",
    "test:eval": "node --test eval/*.test.mjs",
    "eval": "vite build --mode eval && node --env-file-if-exists=.env eval/run.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@playwright/test": "^1.62.1",
    "@release-it/bumper": "^8.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.5",
    "prettier": "3.8.3",
    "release-it": "^21.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.38",
    "@ai-sdk/openai": "^4.0.40",
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/math": "^1.0.2",
    "ai": "^7.0.62",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "mermaid": "^11.16.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "turndown": "^7.2.4",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.4.3"
  }
}
